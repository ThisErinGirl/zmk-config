#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#include <behaviors/unicode.dtsi>
/* https://github.com/urob/zmk-unicode/tree/main/include/zmk-unicode/keys */
#include <zmk-unicode/keys-extra.h>  // All glyphs except CJK

&sensors { triggers-per-rotation = <30>; };

&uc {
  default-mode = <UC_MODE_WIN_COMPOSE>;
};

/ {
    macros {
        pc_sleep_macro: pc_sleep_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp U &kp S>;
            label = "PC_SLEEP_MACRO";
        };

        degree_macro: degree_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "DEGREE_MACRO";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N2 &kp KP_N4 &kp KP_N8>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    behaviors {
        questionmark_and_slash: questionmark_and_slash {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTIONMARK_AND_SLASH";
            bindings = <&kp QUESTION>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        backspace_and_delete: backspace_and_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_AND_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        esc_and_tilde: esc_and_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_AND_TILDE";
            bindings = <&kp ESCAPE>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        slash_and_grave: slash_and_grave {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_AND_GRAVE";
            bindings = <&kp KP_SLASH>, <&kp GRAVE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_and_equals: minus_and_equals {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_AND_EQUALS";
            bindings = <&kp KP_MINUS>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        star_and_degree: star_and_degree {
            compatible = "zmk,behavior-mod-morph";
            label = "STAR_AND_DEGREE";
            bindings = <&kp KP_MULTIPLY>, <&uc UC_DEGREE_SIGN 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        pc_sleep: pc_sleep {
            compatible = "zmk,behavior-hold-tap";
            label = "PC_SLEEP";
            bindings = <&pc_sleep_macro>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&esc_and_tilde    &kp N1  &kp N2  &kp N3         &kp N4  &kp N5                                        &kp N6     &kp N7  &kp N8         &kp N9   &kp N0                   &kp MINUS
&kp TAB           &kp Q   &kp W   &kp E          &kp R   &kp T                                         &kp Y      &kp U   &kp I          &kp O    &kp P                    &backspace_and_delete
&kp LEFT_SHIFT    &kp A   &kp S   &kp D          &kp F   &kp G                                         &kp H      &kp J   &kp K          &kp L    &kp SINGLE_QUOTE         &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C          &kp V   &kp B         &kp C_PLAY_PAUSE    &kp C_MUTE  &kp N      &kp M   &kp COMMA      &kp DOT  &questionmark_and_slash  &kp SEMICOLON
                                  &kp LEFT_META  &mo 1   &kp LEFT_ALT  &kp SPACE           &kp SPACE   &kp ENTER  &mo 2   &pc_sleep 0 0
            >;

            sensor-bindings =
                <&inc_dec_kp C_PREVIOUS C_NEXT>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        lower_layer {
            bindings = <
&trans  &none  &none  &none   &none   &none                     &slash_and_grave  &star_and_degree  &minus_and_equals  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LS(BACKSLASH)
&trans  &none  &none  &none   &none   &none                     &kp KP_NUMBER_7   &kp KP_NUMBER_8   &kp KP_NUMBER_9    &kp PLUS          &kp DOT            &trans
&trans  &none  &none  &none   &none   &none                     &kp KP_NUMBER_4   &kp KP_NUMBER_5   &kp KP_NUMBER_6    &kp KP_NUMBER_0   &kp UP             &trans
&trans  &none  &none  &none   &none   &none   &none     &none   &kp KP_NUMBER_1   &kp KP_NUMBER_2   &kp KP_NUMBER_3    &kp LEFT          &kp DOWN           &kp RIGHT
                      &trans  &trans  &trans  &trans    &trans  &trans            &trans            &trans
            >;
        };

        raise_layer {
            bindings = <
&kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6                                          &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none            &none            &none            &none            &none            &none                                           &none   &none   &none   &none    &none    &none
&none            &none            &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI                                 &none   &none   &none   &none    &none    &none
&rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &none              &none       &none   &none   &none   &none    &none    &none
                                                   &trans           &trans           &none            &rgb_ug RGB_TOG    &bl BL_TOG  &none   &trans  &trans
            >;
        };
    };
};
