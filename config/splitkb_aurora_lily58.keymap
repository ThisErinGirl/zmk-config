#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&sensors {
    triggers-per-rotation = <36>;
};

/ {
    macros {
        pc_sleep: pc_sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp U &kp S>;
            label = "PC_SLEEP";
        };
    };

    behaviors {
        questionmark_and_slash: questionmark_and_slash {
            compatible = "zmk,behavior-mod-morph";
            label = "QUESTIONMARK_AND_SLASH";
            bindings = <&kp QUESTION>, <&kp SLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        leftparenthesis_and_bracket: leftparenthesis_and_bracket {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFTPARENTHESIS_AND_BRACKET";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LEFT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rightparenthesis_and_bracket: rightparenthesis_and_bracket {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHTPARENTHESIS_AND_BRACKET";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        backspace_and_delete: backspace_and_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_AND_DELETE";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        esc_and_tilde: esc_and_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_AND_TILDE";
            bindings = <&kp ESCAPE>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&esc_and_tilde    &kp N1  &kp N2  &kp N3         &kp N4  &kp N5                                        &kp N6     &kp N7  &kp N8     &kp N9   &kp N0                   &kp MINUS
&kp TAB           &kp Q   &kp W   &kp E          &kp R   &kp T                                         &kp Y      &kp U   &kp I      &kp O    &kp P                    &backspace_and_delete
&kp LEFT_SHIFT    &kp A   &kp S   &kp D          &kp F   &kp G                                         &kp H      &kp J   &kp K      &kp L    &kp SINGLE_QUOTE         &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C          &kp V   &kp B         &kp C_PLAY_PAUSE    &kp C_MUTE  &kp N      &kp M   &kp COMMA  &kp DOT  &questionmark_and_slash  &kp SEMICOLON
                                  &kp LEFT_META  &mo 1   &kp LEFT_ALT  &kp SPACE           &kp SPACE   &kp ENTER  &mo 2   &pc_sleep
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREVIOUS>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &kp FSLH  &kp STAR  &kp KP_MINUS  &kp KP_EQUAL  &leftparenthesis_and_bracket  &rightparenthesis_and_bracket
&trans  &trans  &trans  &trans  &trans  &trans                    &kp N7    &kp N8    &kp N9        &kp PLUS      &kp DOT                       &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp N4    &kp N5    &kp N6        &kp N0        &kp UP                        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N1    &kp N2    &kp N3        &kp LEFT      &kp DOWN                      &kp RIGHT
                        &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans
            >;
        };

        raise_layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
